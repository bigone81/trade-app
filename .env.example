APP_PORT=8080
APP_USERNAME=andrei
APP_PASSWORD=change-me
DATABASE_PATH=/data/trade.sqlite
CHARTS_DIR=/data/charts
LIVE_TRADING_ENABLED=false
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=15

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_APP_URL=http://localhost:8080

# Bybit accounts. The numeric slot is discovered dynamically; it is NOT limited to 1..5.
# Existing .env values continue to work and are registered in SQLite exchange_accounts.
# demo=true means Bybit V5 demo trading (not testnet).
BYBIT_ACCOUNT3_NAME=Demo
BYBIT_ACCOUNT3_KEY=
BYBIT_ACCOUNT3_SECRET=
BYBIT_ACCOUNT3_DEMO=true

# Example of another arbitrary slot:
# BYBIT_ACCOUNT10_NAME=Second account
# BYBIT_ACCOUNT10_KEY=
# BYBIT_ACCOUNT10_SECRET=
# BYBIT_ACCOUNT10_DEMO=false
